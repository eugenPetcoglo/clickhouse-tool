{
  "name": "clickhouse-tool",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=24 <25" },
  "overrides": {
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.1" }
  },
  "scripts": {
    "backend:dev": "npm run start:dev --workspace apps/backend",
    "backend:build": "npm run build --workspace apps/backend",
    "backend:start": "npm run start --workspace apps/backend",
    "backend:test": "npm run test --workspace apps/backend"
  }
}
